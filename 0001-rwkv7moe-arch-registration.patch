+// RWKV7 with a sparse MoE channel-mix (dense time-mix, DeepSeek-V3-style shared expert +
+// routed experts + aux-loss-free bias load balancing in place of the dense channel-mix FFN).
+struct llama_model_rwkv7moe : public llama_model_base {
+    llama_model_rwkv7moe(const struct llama_model_params & params) : llama_model_base(params) {}
+    void load_arch_hparams(llama_model_loader & ml) override;
+    void load_arch_tensors(llama_model_loader & ml) override;
+
+    struct graph : public llm_build_rwkv7_base {
+        graph(const llama_model & model, const llm_graph_params & params);
+
+        // token-shift-lerped input shared by the router, the shared expert and every
+        // routed expert (equivalent to the "xk" computed inline in the dense
+        // build_rwkv7_channel_mix, factored out here since it feeds three consumers).
+        ggml_tensor * build_rwkv7moe_channel_mix(const llama_layer * layer,
+                                                  ggml_tensor *       cur,
+                                                  ggml_tensor *       x_prev,
+                                                  int64_t              n_expert,
+                                                  int64_t              n_expert_used,
+                                                  int                  il) const;
+    };
+
+    std::unique_ptr<llm_graph_context> build_arch_graph(const llm_graph_params & params) const override;
+};
